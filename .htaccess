Options -Indexes
RewriteEngine On
DirectoryIndex index.php index.html

# Serve compressed JavaScript artifacts (*.js.gz) with strict JS MIME + gzip.
<IfModule mod_mime.c>
	AddEncoding gzip .gz
</IfModule>

<IfModule mod_headers.c>
	<FilesMatch "\.js\.gz$">
		Header set Content-Type "application/javascript; charset=UTF-8"
		Header set Content-Encoding "gzip"
		Header set X-Content-Type-Options "nosniff"
		Header append Vary "Accept-Encoding"
	</FilesMatch>
</IfModule>

<IfModule mod_mime.c>
	<FilesMatch "\.js\.gz$">
		ForceType application/javascript
	</FilesMatch>
</IfModule>

# Deny direct access to config files
RewriteRule ^config/ - [F,L]

# Allow direct serving of TTS audio cache files (MP3s)
# These are generated by the TTS service and cached under generated/tts/
<IfModule mod_mime.c>
	AddType audio/mpeg .mp3
</IfModule>
RewriteRule ^generated/tts/[a-f0-9]{64}\.mp3$ - [L]

# Canonical API prefix: /api/v1/*.php -> /api/*.php
RewriteRule ^api/v1/(.*)$ /api/$1 [QSA,L]

# API REST Routes - map to PHP handlers
# /api/vessel_designs* -> /api/vessel_designs.php (also handles wireframe_designs)
# NOTE: Disabled - use direct .php file access with query parameters instead
# RewriteCond %{REQUEST_FILENAME} !-f
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteRule ^api/vessel_designs(/.*)?$ /api/vessel_designs.php [QSA,L]

# /api/wireframe_designs* -> /api/wireframe_designs.php
# NOTE: Disabled - POST body not forwarded via RewriteRule; use query parameter approach
# RewriteCond %{REQUEST_FILENAME} !-f
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteRule ^api/wireframe_designs(/.*)?$ /api/wireframe_designs.php [QSA,L]

# /api/generation_queue/* -> /api/generation_queue.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/generation_queue(/.*)?$ /api/generation_queue.php [QSA,L]

# /api/asset_generations/* -> /api/asset_generations.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/asset_generations(/.*)?$ /api/asset_generations.php [QSA,L]

# PHP files in api/ are served directly without RewriteRule
# (POSTDaten werden mit Rewrite Rules nicht korrekt weitergeleitet)
# Instead, allow direct access to .php files in /api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^(.*)$ /index.php [L]
