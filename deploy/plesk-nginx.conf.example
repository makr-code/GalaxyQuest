# Plesk: domain > Apache & nginx Settings > disable "Proxy mode".
# Paste into "Additional nginx directives". Do not modify generated vhost files.
# Replace 8081 with this domain's verified, available WEB_PORT from .env.
# Apply only to the dedicated GalaxyQuest domain; do not alter global Plesk services.
location / {
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_read_timeout 3600s;
}

location = /api/metrics.php {
    return 403;
}
location = /api/v1/metrics.php {
    return 403;
}
