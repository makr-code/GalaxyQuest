# Copy to .env on the server. Never commit actual deployment configuration.
COMPOSE_PROJECT_NAME=galaxyquest-production
DEPLOY_GID=REPLACE_WITH_OUTPUT_OF_ID_G
COMPOSE_PROFILES=gpu
# Examples only. Verify each port is unused on this Plesk host.
WEB_PORT=8081
GRAFANA_PORT=3000
PUBLIC_URL=https://galaxyquest.themisdb.org
# All images MUST use repo@sha256:<64 hex characters>, never floating tags.
WEB_IMAGE=
TTS_IMAGE=
GPU_IMAGE=
MYSQL_IMAGE=
PROMETHEUS_IMAGE=
GRAFANA_IMAGE=
MYSQL_EXPORTER_IMAGE=
NODE_EXPORTER_IMAGE=
BLACKBOX_IMAGE=
ALERTMANAGER_IMAGE=
