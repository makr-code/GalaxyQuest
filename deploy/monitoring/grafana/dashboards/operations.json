{
  "uid": "galaxyquest-operations",
  "title": "GalaxyQuest Operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "Game readiness", "datasource": { "type": "prometheus", "uid": "galaxyquest" }, "gridPos": { "x": 0, "y": 0, "w": 8, "h": 5 }, "targets": [{ "expr": "probe_success{job=\"readiness\"}", "refId": "A" }] },
    { "id": 2, "type": "stat", "title": "MySQL available", "datasource": { "type": "prometheus", "uid": "galaxyquest" }, "gridPos": { "x": 8, "y": 0, "w": 8, "h": 5 }, "targets": [{ "expr": "mysql_up", "refId": "A" }] },
    { "id": 3, "type": "stat", "title": "Targets up", "datasource": { "type": "prometheus", "uid": "galaxyquest" }, "gridPos": { "x": 16, "y": 0, "w": 8, "h": 5 }, "targets": [{ "expr": "up", "legendFormat": "{{job}}", "refId": "A" }] },
    { "id": 4, "type": "timeseries", "title": "Host memory available", "datasource": { "type": "prometheus", "uid": "galaxyquest" }, "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 }, "targets": [{ "expr": "node_memory_MemAvailable_bytes", "refId": "A" }] },
    { "id": 5, "type": "timeseries", "title": "Generation queue", "datasource": { "type": "prometheus", "uid": "galaxyquest" }, "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 }, "targets": [{ "expr": "trellis2_queued_jobs", "refId": "A" }, { "expr": "trellis2_active_jobs", "refId": "B" }] }
  ]
}
